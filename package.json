{
  "name": "@colinagent/hulala-bot",
  "version": "0.3.9",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.6",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "bin": {
    "hulala-bot": "./dist/index.mjs"
  },
  "scripts": {
    "start": "node src/index.ts",
    "test": "node --test tests/",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target=node --format=esm --outfile=dist/index.mjs && bun build src/host/plugin.ts --target=node --format=esm --external @deepseek-ai/* --external @larksuiteoapi/* --outfile=dist/plugin.mjs",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@larksuiteoapi/node-sdk": "^1.76.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist/index.mjs",
    "dist/plugin.mjs",
    "cordis.patch.yml",
    "README.md",
    "docs/README.zh-CN.md",
    "package.json",
    "LICENSE"
  ],
  "exports": {
    "./plugin": "./dist/plugin.mjs"
  },
  "description": "Your local agent on Telegram and Lark: talk to DeepSeek Harness from your phone, switch directories with /cwd, approve tools with a button.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinagent/hulala-bot.git"
  },
  "homepage": "https://github.com/colinagent/hulala-bot#readme",
  "bugs": {
    "url": "https://github.com/colinagent/hulala-bot/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "telegram",
    "lark",
    "feishu",
    "bot",
    "agent",
    "plugin",
    "hulala"
  ],
  "publishConfig": {
    "access": "public"
  }
}
